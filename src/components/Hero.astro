---
import { Button } from "./Button";
---

<div class="hero bg-base-200 min-h-screen font-rokkitt">
    <div class="hero-content flex-col lg:flex-row-reverse">
        <img
            alt="Tailwind CSS hero component"
            src="https://img.daisyui.com/images/stock/photo-1635805737707-575885ab0820.webp"
            class="max-w-sm rounded-lg shadow-2xl"
        />
        <div>
            <h2>Lingerie Shop</h2>
            <h1 class="text-4xl font-medium">Lorem ipsum, dolor sit amet</h1>
            <p class="py-6">
                Lorem ipsum, dolor sit amet consectetur adipisicing elit. <br />
                Aperiam quasi dicta, dolorum sequi distinctio a saepe voluptatibus
                <br />
                est tempora, expedita exercitationem consequatur blanditiis, totam
                numquam. <br /> Magni, consequuntur? Qui, officiis consequatur!
            </p>
            <Button name="Shop" />
        </div>
    </div>
</div>
