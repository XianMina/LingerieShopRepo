---
import { Astronav, MenuItems } from "astro-navbar";
import { ItemLink } from "./ItemLink";
---

<Astronav>
    <div
        class="color-primary bg-base-200 flex items-center justify-between px-48 min-h-20"
    >
        <h1 class="text-primary text-3xl font-light font-rozha uppercase">
            Youth
        </h1>
        <MenuItems class="flex gap-x-10 list-none">
            <ul class="flex gap-x-10 uppercase font-rosarivo">
                <ItemLink url="/">Home</ItemLink>
                <ItemLink url="/">About</ItemLink>
                <ItemLink url="/">Products</ItemLink>
                <ItemLink url="/">Contacts</ItemLink>
            </ul>
        </MenuItems>
    </div>
</Astronav>
