---
interface Props {
  title: String;
  meta: any;
}

const { title, meta } = Astro.props;
import "../styles/global.css";

import { AstroFont } from "astro-font";
---

<!doctype html>
<html lang="en">
  <head>
    <AstroFont
      config={[
        {
          name: "Rozha_One",
          src: [
            {
              style: "normal",
              weight: "400",
              path: "./src/styles/Fonts/Rozha_One/RozhaOne-Regular.ttf",
            },
          ],
          preload: true,
          display: "swap",
          selector: "body",
          fallback: "sans-serif",
        },
      ]}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name={meta} content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
