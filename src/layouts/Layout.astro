---
interface Props {
  title: String;
  meta: any;
}

const { title, meta } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name={meta} content={Astro.generator} />
  <title>{title}</title>
  <body>
    <slot />
  </body>
</html>
