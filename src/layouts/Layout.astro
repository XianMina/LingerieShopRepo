---
interface Props {
  title: String;
  meta: any;
}

const { title, meta } = Astro.props;
import "../styles/global.css";

import { AstroFont } from "astro-font";
---

<!doctype html>
<html lang="en">
  <AstroFont
    config={[
      {
        name: "Rosarivo",
        src: [
          {
            style: "normal",
            weight: "400",
            // Picked up font URL by manually visiting Google Fonts URL
            path: "./src/styles/Fonts/Rosarviro/Rosarivo-Regular.ttf",
          },
        ],
        preload: true,
        display: "swap",
        selector: "body",
        fallback: "serif",
      },
      {
        name: "Rozha_One",
        src: [
          {
            style: "bold",
            weight: "400",
            path: "./src/styles/Fonts/Rosarviro/Rozha_One.ttf",
          },
        ],
        preload: true,
        display: "swap",
        selector: "body > span",
        fallback: "sans-serif",
        cssVariable: "rozha",
      },
    ]}
  />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name={meta} content={Astro.generator} />
  <title>{title}</title>
  <body class="bg-amber-950">
    <slot />
  </body>
</html>
